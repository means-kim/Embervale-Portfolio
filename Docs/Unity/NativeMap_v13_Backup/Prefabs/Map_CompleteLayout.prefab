  m_EditorClassIdentifier: Assembly-CSharp::MapReview.ReviewMapPiece
  editingNotes: "\uC591\uCABD \uACBD\uC0AC\uAC00 \uD55C \uBA54\uC2DC\uC785\uB2C8\uB2E4.
    \uC804\uCCB4 \uC774\uB3D9\uC740 \uC774 \uBD80\uBAA8\uB97C \uC0AC\uC6A9\uD558\uC138\uC694.
